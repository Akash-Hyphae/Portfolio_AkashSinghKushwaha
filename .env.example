# Environment Configuration Template
# Never commit real secret keys or database credentials to source control.

# Application Environment
NODE_ENV=development
PORT=3000
PUBLIC_SITE_URL=http://localhost:3000

# Authentication & Session
SESSION_SECRET=your-random-32-character-secret-string
JWT_SECRET=your-jwt-secret-string

# Administrator Provisioning
ADMIN_EMAIL=akashsinghkushwaha.it27@gmail.com
ADMIN_PASSWORD=your-secure-admin-password

# Database (MongoDB Atlas)
# If left empty, the application automatically uses the atomic file-persisted JSON document store in ./data/
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# Optional: Cloud File Storage (Cloudinary / AWS S3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Transactional Email Notifications
EMAIL_PROVIDER_API_KEY=
CONTACT_NOTIFICATION_EMAIL=akashsinghkushwaha.it27@gmail.com

# AI Studio injected variables
GEMINI_API_KEY=
APP_URL=
